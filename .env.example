# =============================================================================
# SmashVision Web — Environment Variables
# Copy this file to .env (or .env.development / .env.local) and fill in values.
# Variables prefixed with VITE_ are exposed to the browser bundle.
# =============================================================================


# =============================================================================
# DEVELOPMENT ONLY
# These values differ between local dev and production.
# =============================================================================

# Clerk publishable key for the browser-side Clerk SDK.
# Use the TEST key (pk_test_...) in development — found in Clerk Dashboard > API Keys.
# The test key points to a sandboxed Clerk environment that won't affect production users.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_

# Base URL for all REST API calls made by the frontend (serverController.js).
# In development, point this to your local API server.
VITE_API_URL=http://localhost:5000

# WebSocket server URL for real-time camera status updates (Lives page, club dashboard).
# In development, point this to your local API server.
VITE_WS_URL=ws://localhost:5000


# =============================================================================
# PRODUCTION ONLY
# These values are used in the deployed (Vercel) environment.
# =============================================================================

# Clerk publishable key — use the LIVE key (pk_live_...) in production.
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_

# Base URL for all REST API calls.
# VITE_API_URL=https://api.smashvisionapp.com

# WebSocket server URL.
# VITE_WS_URL=wss://api.smashvisionapp.com


# =============================================================================
# SHARED (development + production)
# =============================================================================

# Clerk M2M (machine-to-machine) credentials.
# The smashVisionWeb Vercel proxy (api/proxy/[...path].js) acts as a trusted server
# that forwards browser requests to the API. To prove its identity to the API, it
# obtains a short-lived JWT from Clerk using these M2M credentials.
# This is what allows the API to distinguish trusted frontend calls from random requests.
# Found in Clerk Dashboard > Machine-to-Machine.
CLERK_M2M_CLIENT_SECRET=

# The URL the Vercel proxy forwards API requests to.
# This is the actual backend API — the proxy rewrites all /api/* calls to this URL.
RAILWAY_API_URL=https://api.smashvisionapp.com

# Google Analytics Measurement ID (format: G-XXXXXXXXXX).
# Get this from: analytics.google.com > Admin > Data Streams > Web.
# Leave blank or omit to disable analytics entirely.
# In development you may want to leave this empty to avoid polluting your
# production GA data with local traffic.
VITE_GA_MEASUREMENT_ID=
